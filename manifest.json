{
  "manifest_version": 3,
  "name": "DM Slide",
  "version": "0.0.1",
  "description": "Slide through the reels, posts, stories and photos sent in an Instagram DM conversation, reacting and replying on one screen.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
